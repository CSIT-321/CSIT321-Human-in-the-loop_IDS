# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
hitl-ids/.pytest-tmp/

# Web console
hitl-ids/apps/web/node_modules/
hitl-ids/apps/web/src/node_modules/
hitl-ids/apps/web/dist/
hitl-ids/apps/web/*.tsbuildinfo
hitl-ids/apps/web/test-results/
hitl-ids/apps/web/playwright-report/

# Archives and CSV (the two committed CSV inputs are tracked explicitly)
*.zip
*.csv

# Generated data - rebuilt by the setup steps in README.md
hitl-ids/data/*.db
hitl-ids/data/*.db-journal
hitl-ids/data/*.db-wal
hitl-ids/data/*.db-shm
hitl-ids/data/packet-replay/
hitl-ids/data/processed/demo_ml_predictions_shap.json
hitl-ids/data/processed/stress_ml_predictions.json

# Raw packet captures and local detector tools (not needed for the demo)
hitl-ids/data/raw/pcap/
hitl-ids/.tools/

# Replay inputs: only the two packet-replay window files are committed
hitl-ids/data/spike/*
!hitl-ids/data/spike/Wednesday-14-02-2018/
hitl-ids/data/spike/Wednesday-14-02-2018/*
!hitl-ids/data/spike/Wednesday-14-02-2018/replay-window/
hitl-ids/data/spike/Wednesday-14-02-2018/replay-window/*
!hitl-ids/data/spike/Wednesday-14-02-2018/replay-window/flows.csv
!hitl-ids/data/spike/Wednesday-14-02-2018/replay-window/eve.jsonl

# Local tool state, editor lock files, backups
.omc/
**/.omc/
.claude/
**/.claude/
~$*
*.bak
