diff --git a/hitl-ids/tests/test_tier1_eligibility.py b/hitl-ids/tests/test_tier1_eligibility.py
new file mode 100644
index 0000000..7cbe7ab
--- /dev/null
+++ b/hitl-ids/tests/test_tier1_eligibility.py
@@ -0,0 +1,28 @@
+"""B6 (review S4-05): one rule decides "is this Tier 1 work" for claim, verdict, selective review and routing.
+
+The rule is `analyst_work.is_tier1_work`: route `tier1_review`, stage `triage`, AND a system routing row. Before B6,
+claim and verdict used it, but selective review and the routing actions checked route/stage only. A historical
+non-bundle alert (admitted with no routing row) was therefore Tier 1 work for selective review and routing, and
+not Tier 1 work for claim and verdict.
+"""
+from contextlib import closing
+
+from packages.contracts import db
+from packages.detection import routing, selective_review
+from packages.detection.adapters.operational_v2 import read_triage
+from packages.detection.analyst_work import is_tier1_work
+from test_api import client, database  # noqa: F401  (pytest fixtures)
+from test_selective_review import alerts  # noqa: F401  (pytest fixture: historical non-bundle alerts)
+
+
+def test_a_historical_alert_without_a_routing_row_is_not_tier1_work_anywhere(database, alerts):
+    _, items = alerts
+    alert = items[0]
+    with closing(db.connect(database)) as conn:
+        state = read_triage(conn, alert.id)
+        assert (state.handling_route, state.workflow_stage) == ("tier1_review", "triage")
+        assert conn.execute("SELECT 1 FROM operational_system_routing WHERE operational_alert_id=?",
+                            (alert.id,)).fetchone() is None
+        assert not is_tier1_work(conn, alert.id)
+        assert not selective_review.read_review(conn, alert.operational_alert_ref).eligible_alert
+        assert routing.allowed_actions(state, tier1_work=False) == ()
